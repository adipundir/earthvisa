# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# ...except the RDS certificate authorities, which are PUBLIC root certs, not
# keys. src/lib/db.ts verifies the database's certificate against this bundle,
# so a container built from a git checkout that lacks it falls back to the
# system trust store - which does not contain Amazon's RDS CAs - and every
# single query then fails with SELF_SIGNED_CERT_IN_CHAIN at run time.
!certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code session data
.claude/
brand-assets/

# Earthling dev store (JSON-file storage, dev only)
.data/

# HyperFrames video projects (contain licensed audio + heavy captures)
videos/
# agent skills tooling (installed per-machine via npx skills add)
.agents/
skills-lock.json

# Derived explorer data slices - regenerated by the npm prebuild hook
# (scripts/build-explorer-slices.mjs) from src/data/dataset.json.
/public/explorer/

# Raw statistical source files for acceptance rates - re-fetchable via
# scripts/build-acceptance-*.py; the parsed JSON is what we commit.
data/acceptance-rates/_raw/

# Launch-video working media. Lives in the repo so everything for this
# project is in one place, but stays out of git history - these are large
# binaries derived from a source file, re-creatable via video/separate-stems.py.
video/audio/

# Derived offline data bundles for the iOS app - regenerated by the mobile-bundle
# pipeline stage (scripts/build-mobile-bundle.mjs). manifest.json is synced into
# earthvisa-ios and committed THERE to pin which data a build shipped with.
/public/mobile/
